<!--
======================================================================
DEMO 4 — Custom section: Spend Analytics
======================================================================
This fragment is slotted into the Purchase Order Object Page as a
new section, configured in manifest.json under:

    routing.targets.PurchaseOrdersObjectPage.options.settings.
    content.body.sections.SpendAnalytics

What it renders:
  - macros:Chart bound to UI.Chart#SpendTrendDetail, showing the spend
    trend line for this purchase order's supplier as a full chart (the
    header facet already shows a compact macros:MicroChart version of
    the same data under #SpendTrend — distinct qualifier so the two
    controls don't collide on one ID).
  - macros:Form bound to UI.FieldGroup#VendorSummary, showing key
    supplier attributes alongside the chart.

What we are NOT writing:
  - Column definitions, field labels, criticality logic, responsive
    sizing, theme adaptation, accessibility roles. Every one of those
    is owned by the building block. We are composing layout only.
======================================================================
-->
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:macros="sap.fe.macros">

    <VBox id="idSpendAnalyticsVBox" class="sapUiSmallMargin">
        <HBox id="idSpendAnalyticsHBox" alignItems="Start" justifyContent="SpaceBetween" wrap="Wrap">

            <!-- Full spend trend chart. Distinct qualifier from the
                 header facet's #SpendTrend mini-chart (same data) —
                 reusing one metaPath in two controls on the same page
                 renders duplicate control IDs. -->
            <VBox id="idSpendTrendVBox" class="sapUiSmallMarginEnd" width="55%">
                <!-- No manual Title here: macros:Chart already renders
                     its own caption from UI.Chart.Title — adding one here
                     duplicated the "Spend Trend" heading. -->
                <macros:Chart
                    id="idSpendTrendChart"
                    metaPath="supplierHistory/@com.sap.vocabularies.UI.v1.Chart#SpendTrendDetail"/>
            </VBox>

            <!-- Vendor summary form -->
            <VBox id="idVendorSummaryVBox" class="sapUiSmallMarginEnd" width="480px">
                <macros:Form
                    id="idVendorSummaryForm"
                    metaPath="@com.sap.vocabularies.UI.v1.FieldGroup#VendorSummary"/>
            </VBox>

        </HBox>
    </VBox>

</core:FragmentDefinition>
