<!--
======================================================================
DEMO 4 — Custom section: Spend Analytics
======================================================================
This fragment is slotted into the Purchase Order Object Page as a
new section, configured in manifest.json under:

    routing.targets.PurchaseOrdersObjectPage.options.settings.
    content.body.sections.SpendAnalytics

What it renders:
  - macros:MicroChart bound to UI.Chart#SpendTrendDetail, showing the
    spend trend line for this purchase order's supplier. A separate
    qualifier from the header facet's #SpendTrend chart — same data,
    distinct metaPath, so the two controls don't collide on one ID.
  - macros:Form bound to UI.FieldGroup#VendorSummary, showing key
    supplier attributes alongside the chart.

What we are NOT writing:
  - Column definitions, field labels, criticality logic, responsive
    sizing, theme adaptation, accessibility roles. Every one of those
    is owned by the building block. We are composing layout only.
======================================================================
-->
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:macros="sap.fe.macros">

    <VBox class="sapUiSmallMargin">
        <HBox alignItems="Start" justifyContent="SpaceBetween" wrap="Wrap">

            <!-- Spend trend mini-chart. Distinct qualifier from the
                 header facet's #SpendTrend chart (same data) — reusing
                 one metaPath in two controls on the same page renders
                 duplicate control IDs. -->
            <VBox class="sapUiSmallMarginEnd" width="320px">
                <Title text="Spend Trend" level="H3" class="sapUiSmallMarginBottom"/>
                <macros:MicroChart
                    id="mcSpendTrend"
                    metaPath="@com.sap.vocabularies.UI.v1.Chart#SpendTrendDetail"/>
            </VBox>

            <!-- Vendor summary form -->
            <VBox class="sapUiSmallMarginEnd" width="480px">
                <macros:Form
                    id="frmVendorSummary"
                    metaPath="@com.sap.vocabularies.UI.v1.FieldGroup#VendorSummary"/>
            </VBox>

        </HBox>
    </VBox>

</core:FragmentDefinition>
