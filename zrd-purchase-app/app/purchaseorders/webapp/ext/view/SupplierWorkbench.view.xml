<!--
======================================================================
DEMO 5 — Custom page: Supplier Workbench
======================================================================
This is a custom page composed entirely of building blocks. Registered
in manifest.json under:

    routing.targets.SupplierWorkbench
       type:     Component
       name:     sap.fe.core.fpm    (the FPM custom-page host)
       viewName: zrd.fiori.purchaseorders.ext.view.SupplierWorkbench
       contextPath: /Suppliers

Layout:
  - Side-by-side: macros:Form (SupplierInfo FieldGroup) +
    macros:Chart (SpendByCategory).
  - Below: macros:Table for open purchase orders, driven by
    UI.LineItem#OpenPOs on PurchaseOrders, reached through the
    Suppliers.purchaseOrders association in the table's metaPath.

Note: there is no macros:FilterBar on this page. The page is already
scoped to one supplier via navigation (the route binds a single
Suppliers context), and a FilterBar-connected Table queries its whole
entity set rather than following that navigation — wiring one up here
would silently show purchase orders across all suppliers.

The view is bespoke. The controls are all framework-provided. This is
the highest-leverage extension pattern in the framework: bespoke
layout, standard rendering.
======================================================================
-->
<mvc:View
    controllerName="zrd.fiori.purchaseorders.ext.controller.SupplierWorkbench"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:macros="sap.fe.macros">

    <Page
        id="idSupplierWorkbenchPage"
        title="Supplier Workbench"
        showNavButton="true"
        navButtonPress=".onPageNavButtonPress">

        <content>

            <!-- ============================================
                 Middle: form + chart, side by side
                 ============================================ -->
            <FlexBox
                id="idMiddleFlexBox"
                direction="Row"
                wrap="Wrap"
                alignItems="Start"
                class="sapUiSmallMargin">

                <VBox id="idSupplierInfoVBox" width="40%" class="sapUiSmallMarginEnd">
                    <Title
                        id="idSupplierDetailsTitle"
                        text="Supplier Details"
                        level="H3"
                        class="sapUiSmallMarginBottom"/>
                    <macros:Form
                        id="idSupplierInfoForm"
                        metaPath="@com.sap.vocabularies.UI.v1.FieldGroup#SupplierInfo"/>
                </VBox>

                <VBox id="idSpendByCategoryVBox" width="55%">
                    <Title
                        id="idSpendByCategoryTitle"
                        text="Spend by Category"
                        level="H3"
                        class="sapUiSmallMarginBottom"/>
                    <macros:Chart
                        id="idSpendByCategoryChart"
                        metaPath="spendByCategory/@com.sap.vocabularies.UI.v1.Chart#SpendByCategory"/>
                </VBox>

            </FlexBox>

            <!-- ============================================
                 Bottom: open purchase orders table
                 ============================================ -->
            <VBox id="idOpenPOsVBox" class="sapUiSmallMargin">
                <Title
                    id="idOpenPurchaseOrdersTitle"
                    text="Open Purchase Orders"
                    level="H3"
                    class="sapUiSmallMarginBottom"/>
                <macros:Table
                    id="idOpenPOsTable"
                    metaPath="purchaseOrders/@com.sap.vocabularies.UI.v1.LineItem#OpenPOs"/>
            </VBox>

        </content>

    </Page>

</mvc:View>
