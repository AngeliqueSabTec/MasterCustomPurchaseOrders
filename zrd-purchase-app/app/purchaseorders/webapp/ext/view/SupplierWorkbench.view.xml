<!--
======================================================================
DEMO 5 — Custom page: Supplier Workbench
======================================================================
This is a custom page composed entirely of building blocks. Registered
in manifest.json under:

    routing.targets.SupplierWorkbench
       type:     Component
       name:     sap.fe.core.fpm    <-- the FPM custom-page host
       viewName: zrd.fiori.purchaseorders.ext.view.SupplierWorkbench
       contextPath: /Suppliers

Layout:
  - macros:FilterBar at the top, driven by UI.SelectionFields on
    Suppliers.
  - Side-by-side: macros:Form (SupplierInfo FieldGroup) +
    macros:Chart (SpendByCategory).
  - Below: macros:Table for open purchase orders, driven by
    UI.LineItem#OpenPOs on Suppliers (which uses the
    purchaseOrders association).

The view is bespoke. The controls are all framework-provided. This is
the highest-leverage extension pattern in the framework: bespoke
layout, standard rendering.
======================================================================
-->
<mvc:View
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:macros="sap.fe.macros"
    xmlns:l="sap.ui.layout">

    <Page
        id="pageSupplierWorkbench"
        title="Supplier Workbench"
        showNavButton="true">

        <content>

            <!-- ============================================
                 Top: filter bar
                 ============================================ -->
            <macros:FilterBar
                id="fbSuppliers"
                metaPath="@com.sap.vocabularies.UI.v1.SelectionFields"
                liveMode="true"/>

            <!-- ============================================
                 Middle: form + chart, side by side
                 ============================================ -->
            <FlexBox
                direction="Row"
                wrap="Wrap"
                alignItems="Start"
                class="sapUiSmallMargin">

                <VBox width="40%" class="sapUiSmallMarginEnd">
                    <Title
                        text="Supplier Details"
                        level="H3"
                        class="sapUiSmallMarginBottom"/>
                    <macros:Form
                        id="frmSupplierInfo"
                        metaPath="@com.sap.vocabularies.UI.v1.FieldGroup#SupplierInfo"/>
                </VBox>

                <VBox width="55%">
                    <Title
                        text="Spend by Category"
                        level="H3"
                        class="sapUiSmallMarginBottom"/>
                    <macros:Chart
                        id="chSpendByCategory"
                        metaPath="@com.sap.vocabularies.UI.v1.Chart#SpendByCategory"/>
                </VBox>

            </FlexBox>

            <!-- ============================================
                 Bottom: open purchase orders table
                 ============================================ -->
            <VBox class="sapUiSmallMargin">
                <Title
                    text="Open Purchase Orders"
                    level="H3"
                    class="sapUiSmallMarginBottom"/>
                <macros:Table
                    id="tblOpenPOs"
                    metaPath="@com.sap.vocabularies.UI.v1.LineItem#OpenPOs"/>
            </VBox>

        </content>

    </Page>

</mvc:View>
