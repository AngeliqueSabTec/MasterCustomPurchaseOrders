{
  "name": "zrd-purchase-app",
  "version": "1.0.0",
  "description": "Mastering Custom SAP Fiori Elements - Live Session Demo Bundle (Purchasing Domain)",
  "private": true,
  "license": "Apache-2.0",
  "dependencies": {
    "@sap/cds": "^9",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch-purchaseorders": "cds watch --open zrd.fiori.purchaseorders/index.html?sap-ui-xx-viewCache=false"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/purchaseorders"
  ],
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      }
    }
  }
}
